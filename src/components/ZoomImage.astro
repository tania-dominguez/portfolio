---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  /** Texto del pie en el visor ampliado y en la etiqueta accesible del botón. */
  caption: string;
  width: number;
  widths: number[];
  sizes: string;
  priority?: boolean;
  class?: string;
}

const { image, alt, caption, width, widths, sizes, priority = false, class: className } = Astro.props;
---

<button
  class:list={['image-trigger', className]}
  type="button"
  data-lightbox-src={image.src}
  data-lightbox-alt={alt}
  data-lightbox-caption={caption}
  aria-label={`Ampliar imagen: ${caption}`}
>
  <Picture
    src={image}
    alt={alt}
    width={width}
    widths={widths}
    sizes={sizes}
    formats={['avif', 'webp']}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    decoding="async"
  />
</button>

<style>
  .image-trigger {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    color: inherit;
    background: transparent;
    cursor: zoom-in;
  }

  .image-trigger:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 4px;
  }

  .image-trigger :global(picture) {
    display: block;
    width: 100%;
  }
</style>
