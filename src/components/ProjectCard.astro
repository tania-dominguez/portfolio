---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  category: string;
  description: string;
  href: string;
  cover: ImageMetadata;
  coverAlt: string;
  coverWidth: number;
}

const { title, category, description, href, cover, coverAlt, coverWidth } = Astro.props;

// La imagen crece con la tarjeta hasta 720 px (nunca más que su resolución real)
const maxWidth = Math.min(cover.width, 720);
const widths = [...new Set([coverWidth, Math.min(coverWidth * 2, cover.width), cover.width])].sort((a, b) => a - b);
---

<article class="card">
  <div class="card__media" style={`--cover-max: ${maxWidth}px`}>
    <Picture
      src={cover}
      alt={coverAlt}
      width={coverWidth}
      widths={widths}
      sizes={`(max-width: 52rem) calc(100vw - 5rem), min(${maxWidth}px, 50vw)`}
      formats={['avif', 'webp']}
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="card__body">
    <h3 class="card__title">{title}</h3>
    <p class="card__chip">{category}</p>
    <p class="card__text">{description}</p>
    <a class="btn btn--outline" href={href}>
      Ver proyecto<span class="visually-hidden"> {title}</span>
    </a>
  </div>
</article>

<style>
  /* Material "glass" (Apple HIG): fondo translúcido con desenfoque, borde y reflejo especular */
  .card {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18.65rem, 28%);
    align-items: center;
    gap: var(--space-l) 3.8rem;
    padding: 3.125rem;
    background: linear-gradient(
      135deg,
      rgb(255 255 255 / 0.62),
      rgb(255 255 255 / 0.28) 45%,
      rgb(232 226 209 / 0.45)
    );
    border: 1px solid var(--glass-rim);
    border-radius: 1.75rem;
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow:
      inset 0 1px 0 var(--glass-shine),
      inset 1px 0 0 rgb(255 255 255 / 0.35),
      inset 0 -1px 0 rgb(255 255 255 / 0.2),
      var(--glass-shadow);
  }

  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: radial-gradient(120% 90% at 0% 0%, rgb(255 255 255 / 0.5), transparent 55%);
    pointer-events: none;
  }

  @media (prefers-reduced-transparency: reduce) {
    .card {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      background: var(--color-surface);
    }
  }

  @media (forced-colors: active) {
    .card {
      border-color: CanvasText;
    }
  }

  .card__media {
    justify-self: center;
    width: min(100%, var(--cover-max));
  }

  .card__media :global(img) {
    width: 100%;
    height: auto;
  }

  .card__body {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    padding-block: 1.875rem 0.625rem;
  }

  .card__body > * {
    margin: 0;
  }

  .card__chip {
    padding: 7px;
    font-size: var(--text-s);
    line-height: 1;
    background: var(--color-chip);
    border-radius: var(--radius);
  }

  .card__body > .card__text {
    margin-bottom: 0.9rem;
  }

  @media (max-width: 52rem) {
    .card {
      grid-template-columns: minmax(0, 1fr);
      padding: var(--space-m);
      border-radius: 1.5rem;
    }

    .card__body {
      padding-block: 0;
    }
  }
</style>
