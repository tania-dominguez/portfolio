---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  category: string;
  description: string;
  href: string;
  cover: ImageMetadata;
  coverAlt: string;
  coverWidth: number;
}

const { title, category, description, href, cover, coverAlt, coverWidth } = Astro.props;
---

<article class="card">
  <div class="card__media">
    <Picture
      src={cover}
      alt={coverAlt}
      width={coverWidth}
      widths={[coverWidth, coverWidth * 2]}
      sizes={`(max-width: ${coverWidth}px) 100vw, ${coverWidth}px`}
      formats={['avif', 'webp']}
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="card__body">
    <h3 class="card__title">{title}</h3>
    <p class="card__chip">{category}</p>
    <p class="card__text">{description}</p>
    <a class="btn btn--outline" href={href}>
      Ver proyecto<span class="visually-hidden"> {title}</span>
    </a>
  </div>
</article>

<style>
  .card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 18.65rem);
    align-items: center;
    gap: var(--space-l) 3.8rem;
    padding: 3.125rem;
    background: var(--color-surface);
  }

  .card__media {
    justify-self: center;
    max-width: 100%;
  }

  .card__body {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    padding-block: 1.875rem 0.625rem;
  }

  .card__body > * {
    margin: 0;
  }

  .card__chip {
    padding: 7px;
    font-size: var(--text-s);
    line-height: 1;
    background: var(--color-chip);
    border-radius: var(--radius);
  }

  .card__text {
    margin-bottom: 0.9rem;
  }

  @media (max-width: 52rem) {
    .card {
      grid-template-columns: minmax(0, 1fr);
      padding: var(--space-m);
    }

    .card__body {
      padding-block: 0;
    }
  }
</style>
