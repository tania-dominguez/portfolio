---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  category: string;
  href: string;
  cover: ImageMetadata;
  coverAlt: string;
  /** Las portadas de la primera fila se cargan sin lazy para no penalizar el LCP */
  eager?: boolean;
}

const { title, category, href, cover, coverAlt, eager = false } = Astro.props;

// 1x y 2x de la caja de imagen (~21 rem), sin superar el ancho real de la portada
const widths = [...new Set([Math.min(420, cover.width), Math.min(840, cover.width)])];
---

<article class="card">
  <div class="card__media">
    <Picture
      class="card__img"
      src={cover}
      alt={coverAlt}
      width={widths[widths.length - 1]}
      widths={widths}
      sizes="(min-width: 64rem) 21rem, (min-width: 40rem) 45vw, 90vw"
      formats={['avif', 'webp']}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
    <p class="card__chip">{category}</p>
  </div>

  <h2 class="card__title">
    <a class="card__link" href={href}>{title}</a>
  </h2>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    height: 100%;
    overflow: hidden;
    background: var(--color-card);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  .card__media {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    aspect-ratio: 4 / 3;
    padding: 2.75rem var(--space-m) var(--space-m);
    overflow: hidden;
    background: var(--color-bg);
  }

  /* <picture> la genera Astro: que ocupe la caja y no crezca con el ancho de la imagen */
  .card__media :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
  }

  .card__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .card__chip {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    margin: 0;
    padding: 0.4rem 0.75rem;
    font-size: var(--text-s);
    line-height: 1;
    color: var(--color-ink);
    background: var(--color-surface);
    border-radius: var(--radius-pill);
  }

  .card__title {
    margin: 0;
    padding: var(--space-xs) var(--space-s) var(--space-s);
    font-size: 1.5rem;
    text-align: center;
    line-height: 1.2;
  }

  /* Toda la tarjeta es clicable a través del enlace del título */
  .card__link {
    color: inherit;
    text-decoration: none;
  }

  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* El foco se dibuja alrededor de toda la tarjeta */
  .card__link:focus-visible {
    outline: none;
  }

  .card:has(.card__link:focus-visible) {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }
</style>
