---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

const proyectos = (await getCollection('proyectos', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<div class="projects">
  {
    proyectos.map((p) => (
      <ProjectCard
        title={p.data.title}
        category={p.data.category}
        description={p.data.description}
        href={`/${p.id}/`}
        cover={p.data.cover}
        coverAlt={p.data.coverAlt}
        coverWidth={p.data.coverWidth}
      />
    ))
  }
</div>

<style>
  .projects {
    display: grid;
    gap: 3rem;
    width: min(100% - 2rem, 55.7rem);
    margin-inline: auto;
    padding-block: 3rem;
  }
</style>
