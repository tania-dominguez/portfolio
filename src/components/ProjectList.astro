---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

// En la Home solo salen los proyectos marcados con `home: true`; /portfolio/ los muestra todos.
const proyectos = (await getCollection('proyectos', ({ data }) => !data.draft && data.home)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<div class="projects">
  {
    proyectos.map((p) => (
      <ProjectCard
        title={p.data.title}
        category={p.data.category}
        description={p.data.description}
        href={`/${p.id}/`}
        cover={p.data.cover}
        coverAlt={p.data.coverAlt}
        coverWidth={p.data.coverWidth}
      />
    ))
  }
</div>

<style>
  .projects {
    display: grid;
    gap: 3rem;
    width: var(--home-w);
    margin-inline: auto;
    padding-block: 3rem;
  }
</style>
