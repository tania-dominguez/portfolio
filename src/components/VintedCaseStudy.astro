---
import { Picture } from 'astro:assets';
import hero from '../assets/img/vinted-collections.png';
---

<article class="vinted-case-study" aria-labelledby="vinted-title">
  <section class="vinted-hero" aria-label="Pantallas de la función Vinted Collections">
    <button
      class="vinted-hero__trigger"
      type="button"
      data-lightbox-src={hero.src}
      data-lightbox-alt="Tres pantallas de la app de Vinted con la función para crear y organizar colecciones de favoritos"
      aria-label="Ampliar imagen de Vinted Collections"
    >
      <Picture
        src={hero}
        alt="Tres pantallas de Vinted Collections: favoritos, creación de una colección y selección de productos"
        width={768}
        widths={[320, 480, 640, 768]}
        sizes="(max-width: 40rem) calc(100vw - 2rem), 48rem"
        formats={['avif', 'webp']}
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </button>
  </section>

  <div class="vinted-intro">
    <h1 id="vinted-title">Vinted collections</h1>
    <p>
      Diseño conceptual de una <strong>nueva funcionalidad para la app de Vinted</strong> basada en la posibilidad de crear
      colecciones por parte de los usuarios para poder categorizar y organizar los productos de su lista de favoritos.
    </p>
    <a class="vinted-cta" href="https://www.behance.net/gallery/125044261/Vinted-case-study" target="_blank" rel="noopener noreferrer">
      Ver proyecto en Behance<span class="visually-hidden"> (se abre en una pestaña nueva)</span>
    </a>
  </div>

  <nav class="vinted-project-nav container" aria-label="Navegación entre proyectos">
    <a class="vinted-project-nav__previous" href="/revista-rsc/" rel="prev">
      <span class="vinted-project-nav__arrow" aria-hidden="true">←</span>
      <span><small>Anterior</small>Revista RSC</span>
    </a>
    <span class="vinted-project-nav__divider" aria-hidden="true"></span>
    <a class="vinted-project-nav__next" href="/ilustracion-el-poble-de-la-dana/" rel="next">
      <span><small>Siguiente</small>Ilustración El Poble de la Dana</span>
      <span class="vinted-project-nav__arrow" aria-hidden="true">→</span>
    </a>
  </nav>
</article>

<dialog class="vinted-lightbox" aria-label="Imagen ampliada de Vinted Collections">
  <button class="vinted-lightbox__close" type="button" aria-label="Cerrar imagen ampliada">×</button>
  <img class="vinted-lightbox__image" src="" alt="" />
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.vinted-lightbox');
  const image = dialog?.querySelector<HTMLImageElement>('.vinted-lightbox__image');
  const trigger = document.querySelector<HTMLButtonElement>('[data-lightbox-src]');

  trigger?.addEventListener('click', () => {
    if (!dialog || !image || !trigger) return;
    image.src = trigger.dataset.lightboxSrc ?? '';
    image.alt = trigger.dataset.lightboxAlt ?? '';
    dialog.showModal();
    dialog.querySelector<HTMLButtonElement>('.vinted-lightbox__close')?.focus();
  });

  dialog?.querySelector('.vinted-lightbox__close')?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>

<style>
  .vinted-case-study { color: var(--color-ink); }
  :global(body:has(.vinted-case-study) .site-header__inner) { max-width: none; padding: 14px 10px; }
  .vinted-hero {
    display: grid;
    min-height: 35.5rem;
    padding: 1.5rem 1rem;
    place-items: center;
    background: var(--color-surface);
  }
  .vinted-hero__trigger {
    display: block;
    width: min(100%, 48rem);
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }
  .vinted-hero__trigger picture { display: block; width: 100%; }
  .vinted-hero__trigger :global(img) { display: block; width: 100%; height: auto; }
  .vinted-intro {
    width: min(100% - 2rem, 52rem);
    margin-inline: auto;
    padding-block: 2rem 3.5rem;
    text-align: center;
  }
  .vinted-intro h1 { margin-bottom: 1.5rem; font-size: clamp(2.25rem, 3.8vw, 3rem); }
  .vinted-intro p { max-width: 58rem; margin: 0 auto; font-size: 1.2rem; line-height: 1.5; }
  .vinted-intro strong { font-weight: 700; }
  .vinted-cta {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: center;
    margin-top: 2rem;
    padding: .8rem 2rem;
    border-radius: 3px;
    color: #fff;
    background: #b19141;
    font-size: 1rem;
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-out);
  }
  .vinted-cta:hover { background: var(--color-accent); }
  .vinted-project-nav {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1px minmax(0, 1fr);
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.25rem 2.5rem;
  }
  .vinted-project-nav a {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: .875rem;
    color: var(--color-accent);
    font-size: .95rem;
    text-decoration: none;
  }
  .vinted-project-nav a:hover > span:last-child,
  .vinted-project-nav a:hover > span:first-child { text-decoration: underline; text-underline-offset: .2em; }
  .vinted-project-nav small { display: block; margin-bottom: .2rem; font-size: .78rem; text-transform: uppercase; }
  .vinted-project-nav__arrow {
    display: grid;
    flex: 0 0 2.25rem;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border-radius: 50%;
    color: #fff;
    background: #b19141;
    font-size: 1.45rem;
    line-height: 1;
  }
  .vinted-project-nav__divider { width: 1px; height: 3rem; background: var(--color-border); }
  .vinted-project-nav__next { justify-content: flex-end; text-align: right; }
  .vinted-lightbox {
    position: fixed;
    inset: 0;
    width: min(96vw, 76rem);
    max-width: none;
    max-height: 94dvh;
    margin: auto;
    padding: 3rem 1.5rem 1.5rem;
    border: 0;
    background: #fff;
    box-shadow: 0 1rem 4rem #0005;
  }
  .vinted-lightbox[open] { display: grid; place-items: center; }
  .vinted-lightbox::backdrop { background: rgb(18 14 3 / .88); }
  .vinted-lightbox__image { width: 100%; height: min(78dvh, 54rem); object-fit: contain; }
  .vinted-lightbox__close {
    position: absolute;
    top: .4rem;
    right: .75rem;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    color: var(--color-ink);
    background: transparent;
    font: 2rem/1 var(--font-body);
    cursor: pointer;
  }
  @media (max-width: 40rem) {
    .vinted-hero { min-height: 32rem; padding-inline: 1rem; }
    .vinted-hero__trigger { width: min(100%, 24rem); }
    .vinted-intro { width: min(100% - 2.75rem, 30rem); padding-block: 1.5rem 2rem; }
    .vinted-intro h1 { margin-bottom: .9rem; font-size: 2.25rem; }
    .vinted-intro p { font-size: 1rem; line-height: 1.5; }
    .vinted-cta { margin-top: 1.5rem; }
    .vinted-project-nav { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: .75rem; padding-block: .75rem 1.5rem; }
    .vinted-project-nav__divider { display: none; }
    .vinted-project-nav a { gap: .4rem; font-size: .75rem; }
    .vinted-project-nav small { font-size: .65rem; }
    .vinted-project-nav__arrow { flex-basis: 1.9rem; width: 1.9rem; height: 1.9rem; font-size: 1.2rem; }
    .vinted-lightbox { padding-inline: .75rem; }
  }
  @media (min-width: 48.01rem) {
    :global(body:has(.vinted-case-study) .site-header__inner) { padding-block: 22px; }
  }
</style>


