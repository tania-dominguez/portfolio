---
import linkedin from '../assets/icons/linkedin.svg';
import mail from '../assets/icons/mail.svg';
import { site } from '../data/site';

const linkedinUrl = site.social.find((s) => s.label === 'LinkedIn')?.href;
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <nav aria-label="Legal">
      <ul class="legal">
        {site.legal.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <nav aria-label="Contacto y redes">
      <ul class="social">
        <li>
          <a href={linkedinUrl} aria-label="LinkedIn" rel="me noopener">
            <img src={linkedin.src} width="16" height="16" alt="" />
          </a>
        </li>
        <li>
          <a href="/contacto/" aria-label="Contacto">
            <img src={mail.src} width="16" height="16" alt="" />
          </a>
        </li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    font-size: var(--text-footer);
    line-height: 1.5;
    color: var(--color-on-dark);
    background: var(--color-ink);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem var(--space-l);
    padding: 0.65rem clamp(1rem, 4vw, 2.56rem) 0.775rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .legal a {
    color: inherit;
    text-decoration: none;
  }

  .legal a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .legal li + li {
    margin-left: 0.4rem;
    padding-left: 0.4rem;
    border-left: 1px solid currentColor;
  }

  .social {
    gap: 10px;
  }

  .social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    background: var(--color-surface);
    border-radius: 50%;
  }

  .social a:focus-visible,
  .legal a:focus-visible {
    outline-color: var(--color-on-dark);
  }
</style>
