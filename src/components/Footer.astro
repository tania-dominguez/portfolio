---
import type { ImageMetadata } from 'astro';
import linkedin from '../assets/icons/linkedin.svg';
import behance from '../assets/icons/behance.svg';
import medium from '../assets/icons/medium.svg';
import instagram from '../assets/icons/instagram.svg';
import { site } from '../data/site';

const icons: Record<string, ImageMetadata> = {
  LinkedIn: linkedin,
  Behance: behance,
  Medium: medium,
  Instagram: instagram,
};
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <nav aria-label="Legal">
      <ul class="legal">
        {site.legal.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <nav aria-label="Redes sociales">
      <ul class="social">
        {
          site.social.map((item) => (
            <li>
              <a href={item.href} aria-label={item.label} rel="me noopener">
                <img src={icons[item.label].src} width="16" height="16" alt="" />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    font-size: var(--text-footer);
    line-height: 1.5;
    color: var(--color-on-dark);
    background: var(--color-ink);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem var(--space-l);
    padding: 0.65rem clamp(1rem, 4vw, 2.56rem) 0.775rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .legal a {
    color: inherit;
    text-decoration: none;
  }

  .legal a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .legal li + li {
    margin-left: 0.4rem;
    padding-left: 0.4rem;
    border-left: 1px solid currentColor;
  }

  .social {
    gap: 10px;
  }

  .social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    background: var(--color-surface);
    border-radius: 50%;
  }

  .social a:focus-visible,
  .legal a:focus-visible {
    outline-color: var(--color-on-dark);
  }
</style>
