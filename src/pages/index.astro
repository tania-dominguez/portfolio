---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectList from '../components/ProjectList.astro';
import retrato from '../assets/img/tania-dominguez.png';
---

<BaseLayout title="Tania Domínguez | Diseñadora UX/UI e ilustración en Alicante">
  <section class="hero">
    <h1>¡Hola! Soy Tania Domínguez, diseñadora UX/UI</h1>

    <div class="hero__media">
      <Picture
        src={retrato}
        alt="Ilustración de Tania Domínguez trabajando con un portátil"
        width={390}
        widths={[390, 648]}
        sizes="(max-width: 52rem) 100vw, 390px"
        formats={['avif', 'webp']}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>

    <p class="hero__lead">
      Transformo ideas en experiencias digitales intuitivas y estéticamente atractivas, desde el
      concepto hasta la implementación.
    </p>

    <a class="btn btn--solid hero__cta" href="#proyectos">Ver proyectos</a>
  </section>

  <section id="proyectos" aria-labelledby="proyectos-titulo">
    <h2 id="proyectos-titulo" class="visually-hidden">Proyectos</h2>
    <ProjectList />
  </section>
</BaseLayout>

<style>
  /* Móvil: una columna centrada. Orden: título, imagen, descripción, botón. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    text-align: center;
    width: min(100% - 2rem, var(--container));
    margin-inline: auto;
    padding-top: var(--space-m);
  }

  .hero h1 {
    max-width: 8em;
    margin-bottom: var(--space-m);
  }

  .hero__media {
    max-width: 100%;
    margin-bottom: var(--space-m);
  }

  .hero__lead {
    margin-inline: auto;
    margin-bottom: var(--space-m);
  }

  /* Escritorio: texto a la izquierda (centrado en vertical) e imagen a la derecha. */
  @media (min-width: 52.0625rem) {
    .hero {
      grid-template-columns: minmax(0, 24.3rem) minmax(0, 24.4rem);
      grid-template-rows: 1fr auto auto auto 1fr;
      justify-content: center;
      justify-items: start;
      column-gap: 4.9rem;
      padding-top: 10px;
      text-align: left;
    }

    .hero h1 {
      grid-column: 1;
      grid-row: 2;
    }

    .hero__lead {
      grid-column: 1;
      grid-row: 3;
      margin-inline: 0;
      margin-bottom: 1.5rem;
    }

    .hero__cta {
      grid-column: 1;
      grid-row: 4;
    }

    .hero__media {
      grid-column: 2;
      grid-row: 1 / span 5;
      align-self: center;
      justify-self: center;
      margin-bottom: 0;
    }
  }
</style>
