---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import RevistaRsc from '../components/RevistaRsc.astro';
import DesignSystem42 from '../components/DesignSystem42.astro';

export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos', ({ data }) => !data.draft);
  return proyectos.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} | Tania Domínguez`} description={entry.data.description}>
  {entry.id === 'revista-rsc' ? (
    <RevistaRsc />
  ) : entry.id === '42-design-system' ? (
    <DesignSystem42 />
  ) : (
    <article class="section container">
      <p>{entry.data.category}</p>
      <h1>{entry.data.title}</h1>
      <div class="prose"><Content /></div>
    </article>
  )}
</BaseLayout>

