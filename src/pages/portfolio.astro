---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
---

<BaseLayout
  title="Portfolio | Tania Domínguez"
  description="Proyectos de diseño UX/UI, sistemas de diseño y diseño gráfico de Tania Domínguez."
>
  <PageHeading title="Portfolio" />
  <div class="portfolio-page">
    <PortfolioGrid />
  </div>
</BaseLayout>

<style>
  .portfolio-page {
    background: var(--color-canvas);
  }
</style>
